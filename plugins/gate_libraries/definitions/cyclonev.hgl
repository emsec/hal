                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "d",
                            "direction": "input",
                            "type": "data"
                        }
                    ]
                },
                {
                    "name": "ena",
                    "direction": "input",
                    "type": "enable",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "ena",
                            "direction": "input",
                            "type": "enable"
                        }
                    ]
                },
                {
                    "name": "clrn",
                    "direction": "input",
                    "type": "reset",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "clrn",
                            "direction": "input",
                            "type": "reset"
                        }
                    ]
                },
                {
                    "name": "prn",
                    "direction": "input",
                    "type": "set",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "prn",
                            "direction": "input",
                            "type": "set"
                        }
                    ]
                },
                {
                    "name": "aload",
                    "direction": "input",
                    "type": "data",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "aload",
                            "direction": "input",
                            "type": "data"
                        }
                    ]
                },
                {
                    "name": "asdata",
                    "direction": "input",
                    "type": "data",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
