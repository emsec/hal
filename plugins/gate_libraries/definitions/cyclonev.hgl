{
    "version": 6,
    "library": "cyclonev",
    "cells": [
        {
            "name": "cyclonev_lcell_comb",
            "types": [
                "combinational",
                "c_lut"
            ],
            "parameters": [
                {
                    "name": "lut_mask",
                    "type": "bit_vector",
                    "size": 64,
                    "default": "0x0"
                },
                {
                    "name": "extended_lut",
                    "type": "enum",
                    "values": [
                        "off",
                        "on"
                    ],
                    "default": "off"
                },
                {
                    "name": "shared_arith",
                    "type": "enum",
                    "values": [
                        "off",
                        "on"
                    ],
                    "default": "off"
                }
            ],
            "lut_config": {
                "output_pins": [
                    {
                        "pin": "combout",
                        "data_identifier": "lut_mask",
                        "bit_offset": 0,
                        "bit_count": 64,
                        "is_ascending": true,
                        "input_pins": [
                            "dataa",
                            "datab",
                            "datac",
                            "datad",
                            "datae",
                            "dataf"
                        ]
                    },
                    {
                        "pin": "f0",
                        "data_identifier": "lut_mask",
                        "bit_offset": 0,
                        "bit_count": 16,
                        "is_ascending": true,
                        "input_pins": [
                            "dataa",
                            "datab",
                            "datac",
                            "datad"
                        ]
                    },
                    {
                        "pin": "f1",
                        "data_identifier": "lut_mask",
                        "bit_offset": 16,
                        "bit_count": 16,
                        "is_ascending": true,
                        "input_pins": [
                            "dataa",
                            "datab",
                            "c_or_g",
                            "datad"
                        ]
                    },
                    {
                        "pin": "f2",
                        "data_identifier": "lut_mask",
                        "bit_offset": 32,
                        "bit_count": 16,
                        "is_ascending": true,
                        "input_pins": [
                            "dataa",
                            "datab",
                            "datac",
                            "datad"
                        ]
                    },
                    {
                        "pin": "f3",
                        "data_identifier": "lut_mask",
                        "bit_offset": 48,
                        "bit_count": 16,
                        "is_ascending": true,
                        "input_pins": [
                            "dataa",
                            "datab",
                            "c_or_g",
                            "datad"
                        ]
                    }
                ]
            },
            "pin_groups": [
                {
                    "name": "dataa",
                    "direction": "input",
                    "type": "data",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "dataa",
                            "direction": "input",
                            "type": "data"
                        }
                    ]
                },
                {
                    "name": "datab",
                    "direction": "input",
                    "type": "data",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "datab",
                            "direction": "input",
                            "type": "data"
                        }
                    ]
                },
                {
                    "name": "datac",
                    "direction": "input",
                    "type": "data",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "datac",
                            "direction": "input",
                            "type": "data"
                        }
                    ]
                },
                {
                    "name": "datad",
                    "direction": "input",
                    "type": "data",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "datad",
                            "direction": "input",
                            "type": "data"
                        }
                    ]
                },
                {
                    "name": "datae",
                    "direction": "input",
                    "type": "data",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "datae",
                            "direction": "input",
                            "type": "data"
                        }
                    ]
                },
                {
                    "name": "dataf",
                    "direction": "input",
                    "type": "data",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "dataf",
                            "direction": "input",
                            "type": "data"
                        }
                    ]
                },
                {
                    "name": "datag",
                    "direction": "input",
                    "type": "data",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "datag",
                            "direction": "input",
                            "type": "data"
                        }
                    ]
                },
                {
                    "name": "cin",
                    "direction": "input",
                    "type": "data",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "cin",
                            "direction": "input",
                            "type": "data"
                        }
                    ]
                },
                {
                    "name": "sharein",
                    "direction": "input",
                    "type": "data",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "sharein",
                            "direction": "input",
                            "type": "data"
                        }
                    ]
                },
                {
                    "name": "c_or_g",
                    "direction": "internal",
                    "type": "none",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "c_or_g",
                            "direction": "internal",
                            "type": "none",
                            "function": "((extended_lut == 0b1) ? datag : datac)"
                        }
                    ]
                },
                {
                    "name": "g0_out",
                    "direction": "internal",
                    "type": "none",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "g0_out",
                            "direction": "internal",
                            "type": "none",
                            "function": "(datae ? f1 : f0)"
                        }
                    ]
                },
                {
                    "name": "g1_out",
                    "direction": "internal",
                    "type": "none",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "g1_out",
                            "direction": "internal",
                            "type": "none",
                            "function": "(datae ? f3 : f2)"
                        }
                    ]
                },
                {
                    "name": "adder_input2",
                    "direction": "internal",
                    "type": "none",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "adder_input2",
                            "direction": "internal",
                            "type": "none",
                            "function": "((shared_arith == 0b1) ? sharein : (! f2))"
                        }
                    ]
                },
                {
                    "name": "f0",
                    "direction": "internal",
                    "type": "lut",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "f0",
                            "direction": "internal",
                            "type": "lut"
                        }
                    ]
                },
                {
                    "name": "f1",
                    "direction": "internal",
                    "type": "lut",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "f1",
                            "direction": "internal",
                            "type": "lut"
                        }
                    ]
                },
                {
                    "name": "f2",
                    "direction": "internal",
                    "type": "lut",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "f2",
                            "direction": "internal",
                            "type": "lut"
                        }
                    ]
                },
                {
                    "name": "f3",
                    "direction": "internal",
                    "type": "lut",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "f3",
                            "direction": "internal",
                            "type": "lut"
                        }
                    ]
                },
                {
                    "name": "combout",
                    "direction": "output",
                    "type": "lut",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "combout",
                            "direction": "output",
                            "type": "lut"
                        }
                    ]
                },
                {
                    "name": "sumout",
                    "direction": "output",
                    "type": "none",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "sumout",
                            "direction": "output",
                            "type": "none",
                            "function": "(f0 ^ (cin ^ adder_input2))"
                        }
                    ]
                },
                {
                    "name": "cout",
                    "direction": "output",
                    "type": "none",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "cout",
                            "direction": "output",
                            "type": "none",
                            "function": "((cin & f0) | ((cin & adder_input2) | (f0 & adder_input2)))"
                        }
                    ]
                },
                {
                    "name": "shareout",
                    "direction": "output",
                    "type": "none",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
                    "pins": [
                        {
                            "name": "shareout",
                            "direction": "output",
                            "type": "none",
                            "function": "f2"
                        }
                    ]
                }
            ]
        },
