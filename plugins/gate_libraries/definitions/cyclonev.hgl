        {
            "name": "dffeas",
            "types": [
                "sequential",
                "ff"
            ],
            "parameters": [
                {
                    "name": "power_up",
                    "type": "enum",
                    "values": [
                        "low",
                        "high"
                    ],
                    "default": "low"
                },
                {
                    "name": "async_mode",
                    "type": "enum",
                    "values": [
                        "none",
                        "clear",
                        "preset",
                        "clear_preset",
                        "preset_clear",
                        "load"
                    ],
                    "default": "clear"
                },
                {
                    "name": "sync_mode",
                    "type": "enum",
                    "values": [
                        "none",
                        "clear",
                        "preset",
                        "load",
                        "clear_load",
                        "preset_load"
                    ],
                    "default": "clear_load"
                },
                {
                    "name": "ena_register_mode",
                    "type": "enum",
                    "values": [
                        "always enabled",
                        "use ena"
                    ],
                    "default": "use ena"
                }
            ],
            "ff_config": {
                "state": "IQ",
                "neg_state": "IQN",
                "next_state": "(ena ? (sclr ? 0b0 : (sload ? sdata : d)) : IQ)",
                "clocked_on": "clk",
                "clear_on": "!clrn",
                "preset_on": "prn_b"
            },
            "pin_groups": [
                {
                    "name": "clk",
                    "direction": "input",
                    "type": "clock",
                    "ascending": false,
                    "start_index": 0,
                    "ordered": false,
